# Runtime
NODE_ENV=development
APP_HOST=suite.localhost
CORS_ORIGIN=http://suite.localhost,http://localhost:5173
VITE_API_URL=/api
VITE_DEV_API_PROXY=http://localhost:3000

# Anmeldung, Sitzungs-Cookies und öffentlicher Login-Modus
CARPENTERS_API_URL=http://backendjs:5000
SESSION_SECRET=CHANGE_ME_MINIMUM_32_RANDOM_CHARS
COOKIE_SECURE=false
# Optional: mindestens 24 zufällige Zeichen; wird über ?publicKey=... einmalig ausgetauscht.
PUBLIC_LOGIN_KEY=

# Zentrale Lizenzprüfung. Der API-Key muss einem aktiven Client im
# MoebelDesignLicencing-Server entsprechen.
LICENSE_SERVER_URL=http://licensing-api:5100
LICENSE_SERVER_API_KEY=CHANGE_ME_SAME_VALUE_AS_LICENSING_CLIENT_KEY
LICENSE_SERVER_PRODUCT_ID=moebel-design-suite
LICENSE_SERVER_TIMEOUT_MS=5000
LICENSE_CACHE_TTL_MS=300000

# Kommagetrennte Carpenters-User-UUIDs, die globale Tag-Vorschläge kuratieren dürfen.
GLOBAL_TAG_CURATOR_USER_IDS=

# Existing Traefik instance
TRAEFIK_NETWORK=carpenters-proxy
TRAEFIK_SUITE_HOST=suite.localhost
TRAEFIK_ENTRYPOINT=web

# PostgreSQL (local Compose defaults)
POSTGRES_DB=moebel_design_suite
POSTGRES_USER=moebel_suite
POSTGRES_PASSWORD=change-me-before-production
DATABASE_URL=postgresql://moebel_suite:change-me-before-production@postgres:5432/moebel_design_suite?schema=public
# Use a direct, non-pooled URL here when DATABASE_URL points through PgBouncer.
DIRECT_DATABASE_URL=postgresql://moebel_suite:change-me-before-production@postgres:5432/moebel_design_suite?schema=public

# Valkey / BullMQ
VALKEY_URL=redis://valkey:6379
WORKER_CONCURRENCY=2

# Existing Garage S3 service
S3_ENDPOINT=http://garage:3900
# Browser-reachable Garage endpoint used in presigned upload/download URLs.
S3_PUBLIC_ENDPOINT=http://storage.localhost
S3_REGION=garage
S3_BUCKET=moebel-design-suite
S3_ACCESS_KEY_ID=replace-with-garage-key-id
S3_SECRET_ACCESS_KEY=replace-with-garage-secret
S3_FORCE_PATH_STYLE=true
# Keep false when the bucket is provisioned and assigned in Garage administration.
S3_AUTO_CREATE_BUCKET=false
S3_SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=52428800
# Maximum compressed backup upload size (default: 50 GiB) and image count.
MAX_BACKUP_BYTES=53687091200
MAX_BACKUP_IMAGES=25000

# Only needed with compose.external.yaml when Carpenters services are addressed by container name.
CARPENTERS_NETWORK=carpenters-production
