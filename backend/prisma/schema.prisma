generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ImageStatus {
  PENDING_UPLOAD
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum ImageVariantKind {
  THUMBNAIL
  PREVIEW
}

enum ImageVisibility {
  PRIVATE
  RESTRICTED
  PUBLIC
}

enum TagCategory {
  ROOM
  FURNITURE
  MATERIAL
  COLOR
  STYLE
  FEATURE
  TECHNICAL
}

enum ItemRating {
  LIKE
  DISLIKE
}

enum TagProposalStatus {
  PENDING
  APPROVED
  MERGED
  REJECTED
}

enum LibraryDensity {
  COMFORTABLE
  COMPACT
}

model Image {
  id              String           @id @default(uuid()) @db.Uuid
  objectKey       String           @unique @map("object_key")
  originalName    String           @map("original_name")
  title           String?
  description     String?
  mimeType        String           @map("mime_type")
  byteSize        BigInt?          @map("byte_size")
  contentHash     String?          @map("content_hash") @db.VarChar(64)
  width           Int?
  height          Int?
  metadata        Json?
  status          ImageStatus      @default(PENDING_UPLOAD)
  visibility      ImageVisibility  @default(PRIVATE)
  ownerTenantId   String?          @map("owner_tenant_id") @db.Uuid
  ownerUserId     String?          @map("owner_user_id") @db.Uuid
  rightsConfirmedAt DateTime?      @map("rights_confirmed_at")
  rightsConfirmedBy String?        @map("rights_confirmed_by") @db.Uuid
  errorMessage    String?          @map("error_message")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  variants        ImageVariant[]
  tags            ImageTag[]
  collectionItems CollectionItem[]

  @@index([status])
  @@index([visibility])
  @@index([ownerTenantId, visibility])
  @@index([ownerTenantId, contentHash])
  @@index([createdAt])
  @@map("images")
}

model ImageVariant {
  id        String           @id @default(uuid()) @db.Uuid
  imageId   String           @map("image_id") @db.Uuid
  kind      ImageVariantKind
  objectKey String           @unique @map("object_key")
  mimeType  String           @map("mime_type")
  byteSize  BigInt           @map("byte_size")
  width     Int
  height    Int
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  image     Image            @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([imageId, kind])
  @@index([imageId])
  @@map("image_variants")
}

model Tag {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  slug      String     @unique
  normalizedName String @unique @map("normalized_name")
  category  TagCategory @default(FEATURE)
  createdAt DateTime   @default(now()) @map("created_at")
  images    ImageTag[]
  aliases   TagAlias[]
  proposals TagProposal[] @relation("ResolvedTag")

  @@index([category])
  @@map("tags")
}

model TagAlias {
  id             String   @id @default(uuid()) @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  name           String
  normalizedName String   @unique @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")
  tag            Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId])
  @@map("tag_aliases")
}

model TagProposal {
  id             String            @id @default(uuid()) @db.Uuid
  proposedName   String            @map("proposed_name")
  normalizedName String            @map("normalized_name")
  category       TagCategory
  tenantId       String            @map("tenant_id") @db.Uuid
  proposedBy     String            @map("proposed_by") @db.Uuid
  status         TagProposalStatus @default(PENDING)
  resolvedTagId  String?           @map("resolved_tag_id") @db.Uuid
  decisionNote   String?           @map("decision_note")
  resolvedBy     String?           @map("resolved_by") @db.Uuid
  resolvedAt     DateTime?         @map("resolved_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  resolvedTag    Tag?              @relation("ResolvedTag", fields: [resolvedTagId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([normalizedName])
  @@map("tag_proposals")
}

model ImageTag {
  imageId   String   @map("image_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([imageId, tagId])
  @@index([tagId])
  @@map("image_tags")
}

model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  description String?
  tenantId    String?            @map("tenant_id") @db.Uuid
  userId      String?            @map("user_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  items       CollectionItem[]

  @@index([createdAt])
  @@index([tenantId, userId, updatedAt])
  @@map("collections")
}

model TenantSetting {
  tenantId            String           @id @map("tenant_id") @db.Uuid
  libraryDensity      LibraryDensity   @default(COMFORTABLE) @map("library_density")
  defaultVisibility   ImageVisibility  @default(PRIVATE) @map("default_visibility")
  showExternalImages  Boolean          @default(true) @map("show_external_images")
  updatedBy           String?          @map("updated_by") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

model CollectionItem {
  id           String     @id @default(uuid()) @db.Uuid
  collectionId String     @map("collection_id") @db.Uuid
  imageId      String     @map("image_id") @db.Uuid
  sortOrder    Int        @default(0) @map("sort_order")
  x            Float?
  y            Float?
  width        Float?
  height       Float?
  rotation     Float      @default(0)
  zIndex       Int        @default(0) @map("z_index")
  note         String?
  rating       ItemRating?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  image        Image      @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([collectionId, imageId])
  @@index([collectionId, sortOrder])
  @@index([imageId])
  @@map("collection_items")
}
